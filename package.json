{
  "name": "trekbest",
  "version": "1.0.0",
  "description": "TrekBest Travel & Tours Full-Stack React + Node.js + SQLite Application",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "postinstall": "npm install --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client && node -e \"const fs=require('fs'); fs.cpSync('client/dist', 'dist', {recursive:true});\"",
    "start": "node server.js"
  },
  "keywords": [
    "travel",
    "tours",
    "invoice",
    "react",
    "nodejs",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
